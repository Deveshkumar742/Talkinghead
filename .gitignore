# Source footage and voice reference — large, personal, mirrored to a private
# Kaggle Dataset instead. Never commit likeness or voice data.
assets/*
!assets/README.md

# Pipeline artifact cache
work/
out/
*.mp4
*.wav
*.mp3
!samples/*.txt

# Model weights
weights/
*.ckpt
*.safetensors
*.pth

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Local overrides
.env

# Credentials. The Kaggle token belongs in ~/.kaggle/kaggle.json, never in the
# repo -- but ignore it here too, because a stray copy in the project directory
# is exactly how a secret gets committed by accident.
kaggle.json
.kaggle/
*.pem
*_token
*.key
